# --- secrets ---
.env
.env.*
!.env.example

# --- the shop database ---
# BOTH files are committed on purpose, so a grader can clone and run without
# a setup step: campus_customs.db is the pristine seed, campus_customs_new.db
# is the working copy as the three-ticket run left it ($160, two payments).
# `python scripts/reset_db.py` re-clones the seed for a clean run.
# The sidecars are transient and are not.
data/*.db-wal
data/*.db-shm

# --- python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# --- node ---
node_modules/
frontend/dist/
.vite/

# --- run artifacts ---
# output/ is NOT ignored: harness.md and the run transcripts are deliverables.
*.log

# --- os ---
.DS_Store
Thumbs.db

# Frontend build output and dependencies
frontend/node_modules/
frontend/dist/
