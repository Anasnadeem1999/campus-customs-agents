# Copy to .env and fill in the real key. Never commit .env.

# --- AI model: course Portkey gateway (OpenAI-compatible) ---
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Every agent in this homework must run on gpt-6-luna.
# NOTE: the gateway silently falls back to an older model if this name is
# misspelled, so the code asserts the resolved model at runtime.
MODEL_NAME=gpt-6-luna

# --- database ---
# Agents read and write ONLY the working copy. The pristine seed file
# data/campus_customs.db is never touched.
SEED_DB_PATH=data/campus_customs.db
WORKING_DB_PATH=data/campus_customs_new.db
